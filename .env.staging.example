# STAGING (BETA) environment template. Values are injected by the deploy pipeline / secret manager — do NOT commit real values.
APP_ENV=beta
API_MODE=db
MOCK_PAYMENT=false              # PSP *sandbox* credentials only until production is explicitly authorised
MIGRATE_ON_START=true
MIGRATE_SEED=true               # synthetic data only; customer PII never enters staging
DEMO_DATASET=true
JWT_SECRET=                     # >= 32 random chars, unique to staging
WEBHOOK_SECRET=                 # PSP sandbox webhook signing secret
MYSQL_DSN=                      # dedicated staging MySQL (TLS on)
REDIS_ADDR=
S3_ENDPOINT=                    # staging bucket
