# Sabai jai Travel — local stack configuration.
# DO NOT edit secrets by hand: run  scripts/setup-env.ps1  (Windows)  or  scripts/setup-env.sh  (macOS/Linux)
# to create .env with freshly generated random secrets. .env is git-ignored — never commit it.
# Values below are placeholders; the API refuses placeholder secrets when APP_ENV is beta/production.

# ---- Application ----
APP_ENV=dev                      # dev | beta | production
API_MODE=db                      # db = MySQL persistence (docker stack) | mock = in-memory, no database
API_PORT=8080
MOCK_PAYMENT=true                # must be false in production
MIGRATE_ON_START=true            # apply db/migrations when the API starts
MIGRATE_SEED=true                # synthetic demo data + demo accounts (admin/staff/partner/demo @tep.dev); ignored when APP_ENV=production
JWT_SECRET=__GENERATE__          # >= 32 chars, random

# ---- MySQL 8 ----
MYSQL_DATABASE=tep
MYSQL_USER=tep
MYSQL_PASSWORD=__GENERATE__
MYSQL_ROOT_PASSWORD=__GENERATE__
MYSQL_PORT=3307                     # host port (container stays 3306); 3307 avoids clashing with a local MySQL

# ---- Redis ----
REDIS_PORT=6379

# ---- MinIO (S3-compatible object storage) ----
MINIO_ROOT_USER=__GENERATE__
MINIO_ROOT_PASSWORD=__GENERATE__
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
