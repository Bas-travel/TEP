# Copy to .env and edit. .env is git-ignored. Values below are DEV placeholders only.
APP_ENV=dev                      # dev | beta | production
API_MODE=mock                    # mock | db
API_PORT=8080
# >= 32 chars; MUST be replaced outside dev (API refuses to start with the placeholder in beta/production)
JWT_SECRET=change-me-dev-only-secret-change-me
MOCK_PAYMENT=true                # must be false in production

MYSQL_ROOT_PASSWORD=change-me-root
MYSQL_DATABASE=tep
MYSQL_USER=tep
MYSQL_PASSWORD=change-me-db
MYSQL_PORT=3306
REDIS_PORT=6379
MINIO_ROOT_USER=tepminio
MINIO_ROOT_PASSWORD=change-me-minio
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MIGRATE_SEED=true                # synthetic seed data, ignored when APP_ENV=production
