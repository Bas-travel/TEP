# TEST environment (CI / automated suites). Copy to .env.test. Never reuse values from .env or staging/production.
APP_ENV=dev                      # config accepts dev|beta|production only; "test" is a usage, not a value
API_MODE=db
MOCK_PAYMENT=true               # PSP sandbox/mock only
MIGRATE_ON_START=true
MIGRATE_SEED=true
DEMO_DATASET=false              # tests assert exact baseline counts
JWT_SECRET=__GENERATE__
MYSQL_DATABASE=tep_test         # dedicated schema; tests wipe user tables
MYSQL_USER=tep_test
MYSQL_PASSWORD=__GENERATE__
MYSQL_ROOT_PASSWORD=__GENERATE__
MYSQL_PORT=3317
REDIS_PORT=6389
MINIO_ROOT_USER=__GENERATE__
MINIO_ROOT_PASSWORD=__GENERATE__
MINIO_PORT=9020
MINIO_CONSOLE_PORT=9021
API_PORT=8090
